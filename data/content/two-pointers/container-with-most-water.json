      "pseudocode": [
        "given heights[]",
        "left  ← 0",
        "right ← n − 1; max ← 0",
        "while left < right:",
        "    area = (right − left) × min(h[left], h[right])",
        "    max ← max(max, area)",
        "    if h[left] ≤ h[right] → left++",
        "    else                  → right−−",
        "return max"
      ],
