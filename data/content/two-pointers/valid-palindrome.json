    {
      "label": "Optimized · two pointers",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "pseudocode": [
        "l ← 0;  r ← n − 1",
        "while l < r:",
        "    if not alnum(s[l]): l++; continue",
        "    if not alnum(s[r]): r−−; continue",
        "    if lower(s[l]) != lower(s[r]): return false",
        "    l++; r−−",
        "return true"
      ],
