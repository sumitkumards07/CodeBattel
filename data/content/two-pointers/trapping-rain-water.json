    {
      "label": "Optimized · two pointers, O(1) space",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "pseudocode": [
        "given h[]",
        "left ← 0; right ← n − 1",
        "leftMax ← 0; rightMax ← 0; total ← 0",
        "while left < right:",
        "    if h[left] < h[right]:",
        "        if h[left] ≥ leftMax: leftMax = h[left]",
        "        else: total += leftMax − h[left]",
        "        left++",
        "    else:",
        "        if h[right] ≥ rightMax: rightMax = h[right]",
        "        else: total += rightMax − h[right]",
        "        right−−",
        "return total"
      ],
      "steps": [
        {
          "pointers": {},
          "highlightLine": 1,
          "state": {
            "n": 7
          },
          "narration": "Better idea: we only need to know which side is the BOTTLENECK at each step. Use two pointers walking inward — track the leftMax seen so far (red line) and rightMax (blue line)."
        },
        {
          "pointers": {},
          "highlightLine": 1,
          "state": {
