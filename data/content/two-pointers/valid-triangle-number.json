      "label": "Optimized · fix k + two pointers",
      "complexity": {
        "time": "O(n²)",
        "space": "O(1)"
      },
      "pseudocode": [
        "sort arr",
        "count ← 0",
        "for k ← n − 1 down to 2:",
        "    left ← 0; right ← k − 1",
        "    while left < right:",
        "        if arr[left] + arr[right] > arr[k]:",
        "            count += right − left",
        "            right−−",
        "        else:",
        "            left++",
        "return count"
      ],
