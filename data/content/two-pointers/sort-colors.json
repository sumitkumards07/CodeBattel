      "pseudocode": [
        "given arr",
        "write ← 0                            // pass 1: 0s → front",
        "for i ← 0 to n − 1:",
        "    if arr[i] == 0:",
        "        swap(arr[write], arr[i]); write++",
        "// 0s settled at [0, write)",
        "back ← n − 1;  i ← write             // pass 2: 2s → back",
        "while i ≤ back:",
        "    if arr[i] == 2:",
        "        swap(arr[i], arr[back]); back−−",
        "    else:                              // arr[i] == 1",
        "        i++",
        "return arr"
      ],
